{
  "name": "agent-referee-client",
  "version": "0.8.1",
  "description": "A neutral tie-breaker for AI agents from different owners (verifiable random picks and AI judges) plus sealed review of one agent's output by independent AI reviewers, paid in USDC over x402.",
  "type": "module",
  "main": "src/index.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": ["src", "examples", "docs", "README.md", "CHANGELOG.md", "LICENSE", "TERMS.md", "PRIVACY.md", "SECURITY.md"],
  "repository": { "type": "git", "url": "git+https://github.com/ccheez34/agent-referee-client.git" },
  "homepage": "https://github.com/ccheez34/agent-referee-client#readme",
  "bugs": { "url": "https://github.com/ccheez34/agent-referee-client/issues" },
  "keywords": ["ai-agents", "x402", "multi-agent", "tie-breaker", "ai-judge", "ai-review", "llm-as-judge", "commit-reveal", "randomness", "usdc", "base"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "peerDependencies": { "x402-fetch": ">=1.2.0" },
  "peerDependenciesMeta": { "x402-fetch": { "optional": true } }
}
