{
  "about": "A round where a reveal isn't rock, paper or scissors: each such seat is named and the round isn't scored. Shared by agent-referee-client (test/fixtures) and agent-referee-python (tests); \"@commit:<value>:<nonce>\" stands for sha256 of \"<value>:<nonce>\".",
  "cases": [
    {
      "name": "rps, y wins with lizard",
      "payload": {
        "tier": "rps",
        "match_id": "m1",
        "parties": [
          "x",
          "y"
        ],
        "outcome": {
          "winner": "y"
        },
        "proof": {
          "rounds": [
            {
              "round": 1,
              "commits": {
                "x": "@commit:rock:n1x",
                "y": "@commit:lizard:n1y"
              },
              "reveals": {
                "x": {
                  "value": "rock",
                  "nonce": "n1x"
                },
                "y": {
                  "value": "lizard",
                  "nonce": "n1y"
                }
              },
              "winner": "y"
            }
          ]
        }
      },
      "expect": [
        "Round 1: y revealed something that isn't rock, paper or scissors.",
        "Winner should be nobody."
      ]
    },
    {
